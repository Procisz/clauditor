{
	"name": "clauditor",
	"author": "Ágoston Zajkás",
	"version": "3.0.2",
	"private": true,
	"main": "electron/main.js",
	"scripts": {
		"dev": "vite",
		"build": "vite build && mv dist/index.html dist/Clauditor.html && node scripts/postbuild.mjs",
		"preview": "vite preview",
		"electron:dev": "npm run build && electron .",
		"electron:build": "npm run build && electron-builder",
		"check:pricing": "node scripts/check-pricing.mjs",
		"update:pricing": "node scripts/update-pricing.mjs",
		"check:loader": "node scripts/check-loader.mjs",
		"test": "vitest run"
	},
	"build": {
		"appId": "com.clauditor.app",
		"productName": "Clauditor",
		"files": [
			"electron/**/*",
			"dist/Clauditor.html"
		],
		"directories": {
			"output": "dist-electron"
		},
		"mac": {
			"target": "dmg",
			"category": "public.app-category.developer-tools",
			"icon": "assets/clauditor-icon.png"
		},
		"win": {
			"target": "nsis",
			"icon": "assets/clauditor-icon.png"
		},
		"linux": {
			"target": "AppImage",
			"icon": "assets/clauditor-icon.png"
		}
	},
	"devDependencies": {
		"electron": "^45.1.0",
		"electron-builder": "^26.8.1",
		"html-minifier-terser": "^7.2.0",
		"jsdom": "^30.1.3",
		"vite": "^6.0.0",
		"vite-plugin-html": "^3.2.2",
		"vite-plugin-singlefile": "^2.0.0",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"apexcharts": "^5.10.4"
	}
}
